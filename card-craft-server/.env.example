# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGO_URI=

# Long random string used to sign login tokens. Required: the server won't start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Gemini API key for the AI design review (Google AI Studio). If empty, reviews return 503.
GEMINI_API_KEY=

# Gemini model name for the AI design review (see the model list in Google AI Studio). If empty, reviews return 503.
GEMINI_MODEL=

# The frontend's URL, allowed by CORS. Defaults to http://localhost:5173 when empty.
CLIENT_ORIGIN=

# Port for the server. Defaults to 3000; hosts like Render set this for you.
PORT=
